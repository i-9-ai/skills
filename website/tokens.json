{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "An editorial, precise promotion surface for focused agent skill management.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.078,
          0.137,
          0.102
        ],
        "hex": "#14231a"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.325,
          0.376,
          0.337
        ],
        "hex": "#536056"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.843,
          0.957,
          0.42
        ],
        "hex": "#d7f46b"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.969,
          0.976,
          0.949
        ],
        "hex": "#f7f9f2"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "line": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.718,
          0.749,
          0.714
        ],
        "hex": "#b7bfb6"
      }
    },
    "on-primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.969,
          0.976,
          0.949
        ],
        "hex": "#f7f9f2"
      }
    },
    "on-tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.078,
          0.137,
          0.102
        ],
        "hex": "#14231a"
      }
    },
    "focus": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.192,
          0.365,
          0.22
        ],
        "hex": "#315d38"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 64,
        "unit": "px"
      }
    },
    "section": {
      "$value": {
        "value": 96,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Arial",
        "fontSize": {
          "value": 8,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.055,
          "unit": "em"
        }
      }
    },
    "h1-emphasis": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Georgia",
        "fontSize": {
          "value": 8.56,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": -0.05,
          "unit": "em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Arial",
        "fontSize": {
          "value": 4.5,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.045,
          "unit": "em"
        }
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Arial",
        "fontSize": {
          "value": 1.75,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.025,
          "unit": "em"
        }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Arial",
        "fontSize": {
          "value": 1.125,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "lead": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Arial",
        "fontSize": {
          "value": 1.5,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "control": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Arial",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "monospace",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    }
  }
}
