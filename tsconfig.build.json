{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "noCheck": true,
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
