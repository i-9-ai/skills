{
  "name": "@i-9-ai/skills",
  "version": "0.1.0-rc.1",
  "private": true,
  "description": "A portable collection of focused skills and its validation tooling.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "i9-skills": "./bin/index.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "validate": "node bin/index.mjs validate",
    "test": "node --test \"tests/**/*.test.mjs\" \".agents/skills/*/tests/*.test.mjs\"",
    "check": "npm run format:check && npm run typecheck && npm run validate && npm test",
    "format": "prettier --write \"src/**/*.ts\" \"bin/*.mjs\" \"tests/unit/**/*.mjs\" \"tests/integration/cli/**/*.mjs\" \"tests/packaging/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"bin/*.mjs\" \"tests/unit/**/*.mjs\" \"tests/integration/cli/**/*.mjs\" \"tests/packaging/*.mjs\"",
    "typecheck": "tsc --noEmit",
    "cli": "node bin/index.mjs",
    "ci:official": "node bin/index.mjs ci-official",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "release:prepare": "changeset version",
    "build": "npm run typecheck && node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc --project tsconfig.build.json",
    "package:check": "npm run build && node --test tests/packaging/cli-package.mjs"
  },
  "oclif": {
    "bin": "i9-skills",
    "commands": "./dist/command",
    "topicSeparator": " "
  },
  "config": {
    "officialSkillValidator": {
      "version": "0.1.0",
      "source": "https://codeload.github.com/agentskills/agentskills/tar.gz/69ef37e9424c0a7ea9dd2293b559e43ec8176379",
      "sha256": "0c9eabbe602095c4f4d771ee55bf74f6bc7e1c770f25d4fe29ce9802981daa20",
      "wheels": [
        {
          "name": "click",
          "version": "8.3.1",
          "sha256": "981153a64e25f12d547d3426c367a4857371575ee7ad18df2a6183ab0545b2a6"
        },
        {
          "name": "strictyaml",
          "version": "1.7.3",
          "sha256": "fb5c8a4edb43bebb765959e420f9b3978d7f1af88c80606c03fb420888f5d1c7"
        },
        {
          "name": "python-dateutil",
          "version": "2.9.0.post0",
          "sha256": "a8b2bc7bffae282281c8140a97d3aa9c14da0b136dfe83f850eea9a5f7470427"
        },
        {
          "name": "six",
          "version": "1.17.0",
          "sha256": "4721f391ed90541fddacab5acf947aa0d3dc7d27b2e1e8eda2be8970586c3274"
        },
        {
          "name": "colorama",
          "version": "0.4.6",
          "sha256": "4f1d9991f5acc0ca119f9d443620b77f9d6b33703e51011c16baf57afb285fc6"
        },
        {
          "name": "hatchling",
          "version": "1.27.0",
          "sha256": "d3a2f3567c4f926ea39849cdf924c7e99e6686c9c8e288ae1037c8fa2a5d937b"
        },
        {
          "name": "packaging",
          "version": "25.0",
          "sha256": "29572ef2b1f17581046b3a2227d5c611fb25ec70ca1ba8554b24b0e69331a484"
        },
        {
          "name": "pathspec",
          "version": "0.12.1",
          "sha256": "a0d503e138a4c123b27490a4f7beda6a01c6f288df0e4a8b79c7eb0dc7b4cc08"
        },
        {
          "name": "pluggy",
          "version": "1.6.0",
          "sha256": "e920276dd6813095e9377c0bc5566d94c932c33b27a3e3945d8389c374dd4746"
        },
        {
          "name": "trove-classifiers",
          "version": "2026.6.1.19",
          "sha256": "ab4c4ec93cc4a4e7815fa759906e05e6bb3f2fbd92ea0f897288c6a43efd15b3"
        }
      ]
    }
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@types/node": "^24.13.4",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@oclif/core": "5.0.0",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i-9-ai/skills.git"
  },
  "homepage": "https://github.com/i-9-ai/skills",
  "files": [
    "bin/index.mjs",
    "bin/index.md",
    "dist/**/*.js",
    ".agents/skills/**",
    "skills-catalog.json",
    "docs/**",
    "LICENSE",
    "NOTICE"
  ]
}
